# 金鑰與端點說明見：Ch1_Trust/Nous_Portal.md
# 複製本檔為 .env 後填入（.env 勿提交 git）

# Nous Inference API（sk-nous-…）— 劇本／chat completions
NOUS_API_KEY=sk-nous-xxxxxxxx

# Cursor SDK — pipeline / code 寫碼
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_xxxxxxxx

# LHTL playable 基線目錄（Agent local cwd）
HERMES_GAME_CWD=../../Ch1_Trust_Version3/Renpy_game

# Cursor SDK 模型
HERMES_MODEL=composer-2.5

# pipeline 失敗時 SDK 重試次數
HERMES_MAX_RETRIES=2

# Hermes 內容工廠模型（劇本／JSON 批次產出）
HERMES_CONTENT_MODEL=deepseek/deepseek-v4-pro

# 本地 Nous Portal UI
HERMES_PORTAL_HOST=127.0.0.1
HERMES_PORTAL_PORT=8780

# 官方 Hermes Agent CLI（生圖／TTS；OAuth 見 Nous_Portal.md §4）
# HERMES_CLI_PATH=
HERMES_AGENT_PROVIDER=nous
HERMES_AGENT_MODEL=google/gemini-2.5-pro
HERMES_AGENT_CWD=../..
